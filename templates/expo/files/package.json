{
  "name": "{{projectName}}",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:staged": "lint-staged",
    "test": "jest",
    "prepare": "node scripts/setup-hooks.cjs"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.12",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3"
  }
}
