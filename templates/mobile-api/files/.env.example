NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{projectName}}?schema=public

# DEV-ONLY placeholders (32+ characters required). Generate real secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-replace-me-before-deploying
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
